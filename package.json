{
  "name": "margarita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "margarita": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "lint": "bun lint --no-script --type-aware --max-warnings 0",
    "typecheck": "bun check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@opencode/client": "2.3.0",
    "@opentui/core": "0.9.2",
    "@opentui/solid": "0.9.2",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
