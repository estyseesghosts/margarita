{
  "name": "margarita",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "marg": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "capture:fixtures": "bun run scripts/capture-fixtures.ts",
    "bench": "bun run scripts/bench.ts",
    "bench:render": "bun run scripts/bench-render.ts",
    "start": "bun run src/main.ts",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "typecheck": "bun check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:writable": "bun run scripts/test-writable.ts",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "dependencies": {
    "@opencode/client": "2.3.0",
    "@opentui/core": "0.9.2",
    "@opentui/solid": "0.9.2",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2"
  }
}
